#!/bin/bash
# Black-box checks for the smoke task. Prints `ok <name>` / `fail <name> <detail>`.
cd "$(dirname "$0")" >/dev/null 2>&1 || true
cd - >/dev/null 2>&1 || true

report() { printf '%s %s %s\n' "$1" "$2" "${3:-}"; }

if ! cargo build --quiet 2> build.err; then
  report fail builds "$(tail -c 300 build.err | tr '\n' ' ')"
  exit 1
fi
report ok builds

out=$(cargo run --quiet -- hello World 2>/dev/null)
[ "$out" = "Hello, World!" ] && report ok hello || report fail hello "got: $out"

out=$(cargo run --quiet -- hello World --shout 2>/dev/null)
[ "$out" = "HELLO, WORLD!" ] && report ok shout || report fail shout "got: $out"

out=$(cargo run --quiet -- hello World --output json 2>/dev/null)
if printf '%s' "$out" | python3 -c 'import sys, json; d = json.load(sys.stdin); sys.exit(0 if d.get("greeting") == "Hello, World!" else 1)' 2>/dev/null; then
  report ok json
else
  report fail json "got: $out"
fi

[ -f NOTES.md ] && report ok notes || report fail notes "NOTES.md missing"
